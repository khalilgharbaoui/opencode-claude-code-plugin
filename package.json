{
  "name": "@khalilgharbaoui/opencode-claude-code-plugin",
  "version": "0.46.1",
  "description": "Claude Code CLI provider plugin for opencode",
  "homepage": "https://opencode-claude-code-plugin.dev/",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/khalilgharbaoui"
  },
  "author": "Khalil Gharbaoui",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "OPENCODE_CLAUDE_CODE_LOG_FILE=0 XDG_STATE_HOME=$(mktemp -d) tsx --test test/*.test.ts",
    "generate:log-messages": "tsx scripts/generate-log-messages.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "opencode",
    "claude",
    "claude-code",
    "ai-sdk",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalilgharbaoui/opencode-claude-code-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
