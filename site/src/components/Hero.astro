---
/*
  Overrides Starlight's Hero (astro.config.mjs: components.Hero). On the landing page it
  renders the plugin's own hero: a bar-led monospace title, the two-sentence tagline,
  the install block and the turn replay, all meant to fit the first screen at 1440x900
  and at 390x844. On every other page that declares `hero:` it defers to Starlight's default,
  so the override never changes a docs page.

  Reads the same frontmatter fields as the default Hero (title, tagline, actions), so
  the copy stays in index.mdx where an editor expects it. The install snippet is the one
  from docs/getting-started.md; the version is the npm figure stats.ts reads.

  The copy button is an enhancement: it is hidden until scripting runs, so without it
  the snippet is plain, selectable text. The script prefers the async clipboard and
  falls back to selecting the snippet where that API is unavailable.
*/
import Default from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import TurnReplay from './TurnReplay.astro';
import { loadStats } from '../data/stats';

const { starlightRoute } = Astro.locals;
const isHome = starlightRoute.id === '';
const { data } = starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (link: string) => (link.startsWith('/') ? `${base}${link}` : link);

const stats = isHome ? await loadStats() : undefined;
---

{
  isHome ? (
    <div class="occ-hero not-content">
      <div class="occ-hero__copy">
        <h1 id="_top" tabindex="-1" data-page-title class="occ-hero__title" set:html={title} />
        {tagline && <p class="occ-hero__tagline" set:html={tagline} />}

        <div class="occ-install">
          <p class="occ-install__lead">
            <strong class="occ-install__tldr">tl;dr</strong> just install it, and{' '}
            <a class="occ-install__coffee" href="https://www.buymeacoffee.com/khalilgharbaoui" rel="noopener">support it</a>{'\u00a0'}<span class="occ-install__face" aria-hidden="true">☕😌</span>
          </p>
          <div class="occ-install__window">
            <div class="occ-install__bar">
              <span class="occ-install__file">opencode.json</span>
              <span class="occ-install__tools">
                {stats && (
                  <a
                    class="occ-install__ver"
                    href="https://www.npmjs.com/package/@khalilgharbaoui/opencode-claude-code-plugin"
                    rel="noopener"
                    title="The version npm installs today"
                  >
                    <span class="occ-install__ver-dot" aria-hidden="true" />
                    <span class="occ-install__ver-label">npm</span> v{stats.npmVersion}
                  </a>
                )}
                <button type="button" class="occ-copy" data-copy="#occ-install-code" aria-label="Copy the opencode.json snippet" hidden>
                  <svg class="occ-copy__icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                    <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
                  </svg>
                  <svg class="occ-copy__done" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8.5l3.2 3L13 4.5" />
                  </svg>
                  <span class="occ-copy__label">copy</span>
                </button>
              </span>
              <span class="sr-only" role="status" aria-live="polite" id="occ-copy-status" />
            </div>
            <pre class="occ-install__code" id="occ-install-code" tabindex="0" aria-label="opencode.json installation snippet"><code><span class="occ-tok--p">{'{'}</span>{'\n  '}<span class="occ-tok--key">"plugin"</span><span class="occ-tok--p">: [</span>{'\n    '}<span class="occ-tok--str">"@khalilgharbaoui/opencode-claude-code-plugin"</span>{'\n  '}<span class="occ-tok--p">]</span>{'\n'}<span class="occ-tok--p">{'}'}</span></code></pre>
          </div>
          <div class="occ-install__foot">
            <p>
              Add it to <code>opencode.json</code> and relaunch. Needs <code>claude</code> installed and logged in.
            </p>
          </div>
        </div>

        {actions.length > 0 && (
          <div class="occ-hero__actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
              <LinkButton href={withBase(link)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ))}
          </div>
        )}
      </div>
      <TurnReplay />
    </div>
  ) : (
    <Default>
      <slot />
    </Default>
  )
}

<script>
  const button = document.querySelector<HTMLButtonElement>('.occ-copy');
  const code = button ? document.querySelector<HTMLElement>(button.dataset.copy ?? '') : null;
  const status = document.getElementById('occ-copy-status');
  const label = button?.querySelector<HTMLElement>('.occ-copy__label');
  if (button && code && label) {
    button.hidden = false;
    const idle = label.textContent;
    let reset = 0;
    const say = (text: string, state: 'copied' | 'select') => {
      if (status) status.textContent = '';
      label.textContent = text;
      button.dataset.state = state;
      if (status) status.textContent = state === 'copied' ? 'Snippet copied to the clipboard.' : 'Snippet selected; copy it with your keyboard.';
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = idle;
        delete button.dataset.state;
      }, 1800);
    };
    button.addEventListener('click', async () => {
      const text = code.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        say('copied', 'copied');
      } catch {
        code.focus();
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        say('selected', 'select');
      }
    });
  }
</script>

<style>
  /* The glow behind this hero is a background on the landing page's frame
     (custom.css, "The one glow"): it has to bleed to the viewport's edge, which a
     pseudo-element inside the content column cannot do without a hard edge. */
  .occ-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--occ-space-4);
    align-items: start;
    padding-block: 0 var(--occ-space-4);
  }
  .occ-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--occ-space-3);
    min-width: 0;
  }

  /* The title is set the way the plugin writes a note into a transcript:
     a thick left bar, then the line. Monospace so it reads as output, not marketing.
     Capped so "Claude Code is" fits one line in the narrower copy column from 80rem up. */
  .occ-hero__title {
    margin: 0;
    padding-inline-start: 0.5em;
    border-inline-start: 0.28em solid var(--occ-bar);
    font-family: var(--__sl-font-mono);
    font-size: clamp(1.875rem, 1rem + 2.9vw, 3.25rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .occ-hero__tagline {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(var(--sl-text-base), 0.9rem + 0.5vw, var(--sl-text-lg));
    line-height: 1.5;
    color: var(--occ-ink-2);
    text-wrap: pretty;
  }
  .occ-hero__tagline :global(code),
  .occ-install__foot code {
    font-family: var(--__sl-font-mono);
    font-size: 0.9em;
    padding: 0.05em 0.3em;
    border: 1px solid var(--occ-line);
    border-radius: 4px;
    background: var(--sl-color-bg-inline-code);
  }
  .occ-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--occ-space-3) var(--occ-space-6);
    align-items: center;
  }
  .occ-hero__actions :global(.sl-link-button) {
    min-block-size: 2.75rem;
    margin: 0;
  }

  /* The install block: the whole setup, above the fold. Three rows, each with one
     job: the sentence on a line of its own, the snippet in a small code window whose
     title bar carries the file name and the copy button (so the button never shares
     a row with prose), and the setup note with the published version beside it. */
  .occ-install {
    display: flex;
    flex-direction: column;
    gap: var(--occ-space-2);
    max-width: 36rem;
  }
  .occ-install__lead {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--occ-ink-2);
    text-wrap: balance;
  }
  .occ-install__tldr {
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }
  .occ-install__coffee {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--occ-bar);
    text-underline-offset: 0.2em;
  }
  .occ-install__coffee:hover {
    color: var(--sl-color-text-accent);
  }
  .occ-install__face {
    font-family: system-ui, sans-serif;
    white-space: nowrap;
  }

  /* The window: a panel in the hairline vocabulary, led by the bar. */
  .occ-install__window {
    border: 1px solid var(--occ-line);
    border-inline-start: 4px solid var(--occ-bar);
    border-radius: 0 var(--occ-radius) var(--occ-radius) 0;
    background: var(--occ-panel);
    box-shadow: inset 0 1px 0 var(--occ-highlight);
    overflow: hidden;
  }
  .occ-install__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--occ-space-2);
    padding-inline: var(--occ-space-3) var(--occ-space-1);
    border-block-end: 1px solid var(--occ-line);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    color: var(--occ-ink-3);
  }
  .occ-install__file {
    letter-spacing: 0.02em;
  }
  .occ-install__code {
    margin: 0;
    padding: var(--occ-space-2) var(--occ-space-3);
    background: transparent;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    color: var(--occ-ink-1);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    tab-size: 2;
  }
  .occ-install__code:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .occ-install__code code {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
  }
  /* The snippet's tokens use the site's shared code-token colours (custom.css, Code
     tokens), the same ones the replay bodies use, in both themes. */

  /* Quiet until wanted: a ghost button in the title bar, a hairline on hover, and a
     check plus the accent once the snippet is on the clipboard. Fixed width, so
     "copy" becoming "copied" never moves the bar. */
  .occ-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5ch;
    inline-size: 5.75rem;
    min-block-size: 2.25rem;
    margin: var(--occ-space-1) 0;
    padding: 0 var(--occ-space-2);
    border: 1px solid transparent;
    border-radius: var(--occ-radius-sm);
    background: transparent;
    color: var(--occ-ink-2);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      border-color var(--occ-duration),
      color var(--occ-duration),
      background-color var(--occ-duration);
  }
  .occ-copy:hover,
  .occ-copy:focus-visible {
    border-color: var(--occ-line-strong);
    color: var(--sl-color-white);
  }
  .occ-copy__done {
    display: none;
  }
  .occ-copy[data-state='copied'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
  .occ-copy[data-state='copied'] .occ-copy__icon {
    display: none;
  }
  .occ-copy[data-state='copied'] .occ-copy__done {
    display: inline;
  }
  .occ-copy[hidden] {
    visibility: hidden;
    display: inline-flex;
  }

  .occ-install__foot p {
    margin: 0;
    font-size: var(--sl-text-2xs);
    line-height: 1.5;
    color: var(--occ-ink-3);
    text-wrap: pretty;
  }
  /* The version npm serves today, as a small pill beside the copy button: it
     describes the package in the snippet, so it lives in the snippet's own bar. */
  .occ-install__tools {
    display: inline-flex;
    align-items: center;
    gap: var(--occ-space-2);
  }
  .occ-install__ver {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    min-block-size: 1.75rem;
    padding: 0 0.75ch;
    border: 1px solid var(--occ-line);
    border-radius: 999px;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-2xs);
    color: var(--occ-ink-2);
    text-decoration: none;
    transition:
      border-color var(--occ-duration),
      color var(--occ-duration);
  }
  .occ-install__ver:hover,
  .occ-install__ver:focus-visible {
    border-color: var(--occ-bar);
    color: var(--sl-color-text-accent);
  }
  .occ-install__ver-label {
    color: var(--occ-ink-3);
  }
  .occ-install__ver-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background: var(--occ-bar);
  }
  @media (max-width: 26rem) {
    .occ-install__code {
      padding-inline: var(--occ-space-2);
      font-size: 0.6875rem;
    }
    .occ-hero__actions {
      gap: var(--occ-space-2);
    }
    .occ-hero__actions :global(.sl-link-button) {
      font-size: var(--sl-text-sm);
      padding: var(--occ-space-2) var(--occ-space-3);
    }
  }

  /* Stacked below 64rem: a tablet column is too narrow for both the title and the
     replay's lines. Two equal columns from there, and from 80rem the replay takes the
     larger share: its longest lines wrap less, so the whole first turn stays above the
     fold at 1440x900, while the copy column still holds "Claude Code is" on one line. */
  @media (min-width: 64rem) {
    .occ-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--occ-space-8);
      padding-block: clamp(var(--occ-space-4), 2.5vw, 2.5rem) var(--occ-space-8);
    }
    .occ-hero__copy {
      gap: var(--occ-space-6);
    }
  }
  @media (min-width: 80rem) {
    .occ-hero {
      grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
      gap: var(--occ-space-12);
    }
  }
</style>
