---
/*
  The hero's panel: three turns, each replayed line by line the way a transcript is
  written, and each ending on the line the user sees in opencode. Illustrative,
  abbreviated examples built from real line shapes, not recordings. They use the
  opencode 1.x vocabulary (`filePath`, inline /btw); src/host-tools.ts renames on 2.x.

  1. A proxied tool. The spawn flags from src/session-manager.ts (`buildCliArgs`, which
     pushes every disallowed tool as its own argument), the built-ins each proxied tool
     disables (src/proxy-mcp.ts, docs/guides/tool-proxy.md), the stream-json frames the
     fake CLI in test/proxy-task.test.ts emits, the held HTTP request and its 15-second
     keepalive (docs/internals/how-a-proxied-call-ends.md). The one number in it, the
     test count, is the live figure stats.ts reads from the suite's own summary line.
  2. Claude's own tool. A second turn in the same conversation: the process is reused
     and only the new message is written to its stdin (docs/internals/how-a-turn-works.md).
     `Read` runs inside Claude Code and reaches opencode as a tool part whose result
     carries the same name (docs/guides/tool-proxy.md, PR #46). The answer is
     docs/introduction.md's own sentence about tokens.
  3. /btw while a turn runs. The `side_question` control request and where its answer
     sits on the wire (src/side-question.ts), the receipt and the inline block as
     docs/guides/btw.md renders them, and an answer whose substance is the proxy
     deadline guard (AGENTS.md, h #g27).

  No cost, duration or token figure appears: those would be invented.

  Markup: one ordered list per turn, one item per line, each a three-column grid
  (speaker, bar, body). Not a <pre>: there the template's own newlines render, and a
  grid inside it stacks every span. The three lists share one grid cell, so the panel
  keeps the tallest turn's height and nothing below it moves when the turn changes.
  A line that has not been spoken yet is transparent, not removed: the panel is full
  height from the first frame and every line stays in the accessibility tree.

  Motion: one clock in the script reveals a line per tick, each line carrying its own
  pacing, streams the final answer a word at a time, holds, then moves to the next turn
  and starts over. The cursor sits after the newest word. Pause stops the clock. A mouse
  over the panel, or focus inside it, holds a finished turn so it can be read. A turn
  picked by hand plays and then stays. Without scripting the first turn plays once in
  CSS (animation-delay), exactly as the pass-2 panel did. Under prefers-reduced-motion
  the clock still reveals the turn line by line, because text appearing in place is not
  movement, but nothing fades, rises or blinks, and pause and restart stay on screen.
  Showing every line at once instead read as "the demo does not play" on a phone with
  Reduce Motion on (2026-10-08), the setting's commonest home.
*/
import { loadStats } from '../data/stats';

const stats = await loadStats();
const tests = stats.tests.toLocaleString('en-US');

type Lane = 'opencode' | 'plugin' | 'claude';
interface Line {
  lane: Lane;
  tag?: string;
  text: string;
  note?: string;
  /** The transcript bar: on every plugin line, and on what opencode shows the user. */
  bar?: boolean;
  /** Streams a word at a time, the way a reply arrives in opencode. */
  stream?: boolean;
  /** Milliseconds the clock waits after this line. The script's default is 520. */
  wait?: number;
}
interface Turn {
  id: string;
  label: string;
  title: string;
  lines: Line[];
}

const words = (text: string): string[] => text.match(/\S+\s*/g) ?? [text];

/**
 * Syntax colour for a replayed line, at build time: JSON keys and strings, argv
 * flags, `<placeholders>`, numbers and punctuation. One pass over the text; what
 * the regex does not claim stays plain. The colours live in custom.css (Code
 * tokens) and follow the theme.
 */
type TokenClass = 'key' | 'str' | 'flag' | 'ph' | 'num' | 'p';
interface Token {
  cls?: TokenClass;
  text: string;
}
const TOKEN =
  /("(?:[^"\\]|\\.)*")(\s*:)|("(?:[^"\\]|\\.)*")|(--[\w-]+)|(<[^>]+>)|((?<![\w-])(?:true|false|null|\d[\d,.]*)(?![\w-]))|([{}[\]:,\u2026]|\u2192)/g;
function tokenize(text: string): Token[] {
  const out: Token[] = [];
  let last = 0;
  for (const match of text.matchAll(TOKEN)) {
    const at = match.index ?? 0;
    if (at > last) out.push({ text: text.slice(last, at) });
    if (match[1] !== undefined) {
      out.push({ cls: 'key', text: match[1] });
      out.push({ cls: 'p', text: match[2] });
    } else if (match[3] !== undefined) out.push({ cls: 'str', text: match[3] });
    else if (match[4] !== undefined) out.push({ cls: 'flag', text: match[4] });
    else if (match[5] !== undefined) out.push({ cls: 'ph', text: match[5] });
    else if (match[6] !== undefined) out.push({ cls: 'num', text: match[6] });
    else out.push({ cls: 'p', text: match[0] });
    last = at + match[0].length;
  }
  if (last < text.length) out.push({ text: text.slice(last) });
  return out;
}

const turns: Turn[] = [
  {
    id: 'proxy',
    label: 'Tool proxy',
    title: 'A proxied tool runs in opencode, under its permissions',
    lines: [
      { lane: 'opencode', tag: 'you', text: 'run the suite. which test files cover the proxy broker?', wait: 900 },
      {
        lane: 'plugin',
        tag: 'spawn',
        text: 'claude --print --output-format stream-json --input-format stream-json --model claude-sonnet-5-5',
        bar: true,
      },
      {
        lane: 'plugin',
        tag: 'with',
        text: '--mcp-config <0600, bearer token inside> --append-system-prompt-file <0600> --disallowedTools Bash Edit MultiEdit Write WebFetch Agent',
        bar: true,
        wait: 700,
      },
      {
        lane: 'claude',
        text: '{"type":"system","subtype":"init", … "mcp_servers":[{"name":"opencode_proxy","status":"connected"}]}',
        wait: 420,
      },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"tool_use","name":"Grep","input":{"pattern":"queuePendingProxyCall"}}}',
        note: 'ran inside Claude Code',
        wait: 700,
      },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"tool_use","name":"mcp__opencode_proxy__bash","input":{"command":"npm test"}}}',
        wait: 420,
      },
      {
        lane: 'plugin',
        tag: 'tool-call',
        text: "bash → opencode. The CLI's HTTP request stays open, with a keepalive every 15 s.",
        bar: true,
        wait: 700,
      },
      { lane: 'opencode', tag: 'permission', text: 'run npm test?', wait: 1100 },
      { lane: 'opencode', tag: 'you', text: 'allow once', wait: 700 },
      {
        lane: 'opencode',
        tag: 'bash',
        text: `ran here, under opencode's own permissions and audit log · ${tests} tests`,
        wait: 800,
      },
      {
        lane: 'plugin',
        tag: 'tool-result',
        text: '→ claude. The held request resolves; the model carries on.',
        bar: true,
        wait: 600,
      },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"text","text":"test/broker.test.ts and test/proxy-task.test.ts: per-tool deadlines, the guard, stall warnings, fan-out, late results."}}',
        wait: 420,
      },
      { lane: 'claude', text: '{"type":"result","subtype":"success","is_error":false}', wait: 500 },
      {
        lane: 'opencode',
        tag: 'reply',
        text: `test/broker.test.ts and test/proxy-task.test.ts cover the broker: per-tool deadlines, the guard, stall warnings, fan-out and late results. All ${tests} tests pass.`,
        note: 'the CLI authenticated this turn; the plugin read no token',
        bar: true,
        stream: true,
      },
    ],
  },
  {
    id: 'read',
    label: 'Native Read',
    title: "Claude's own tool, with no proxy in the way",
    lines: [
      { lane: 'opencode', tag: 'you', text: 'does this plugin ever touch my Claude login?', wait: 900 },
      {
        lane: 'plugin',
        tag: 'reuse',
        text: "the conversation's claude process is still alive: nothing is spawned, only the new message is written to its stdin. Full context kept.",
        bar: true,
        wait: 800,
      },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"tool_use","name":"Read","input":{"file_path":"docs/introduction.md"}}}',
        note: 'ran inside Claude Code, not through the proxy',
        wait: 600,
      },
      {
        lane: 'plugin',
        tag: 'tool-call',
        text: 'Read → opencode, as a tool part only: Claude Code runs it, opencode renders the row.',
        bar: true,
        wait: 600,
      },
      {
        lane: 'claude',
        text: '{"type":"user", … {"type":"tool_result","tool_use_id":"toolu_01…","content":"# Introduction …"}}',
        wait: 500,
      },
      { lane: 'opencode', tag: 'read', text: 'docs/introduction.md · ran by Claude Code, shown here as it completes', wait: 700 },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"text","text":"No. The plugin never reads, stores or replays an OAuth token of its own …"}}',
        wait: 420,
      },
      { lane: 'claude', text: '{"type":"result","subtype":"success","is_error":false}', wait: 500 },
      {
        lane: 'opencode',
        tag: 'reply',
        text: 'No. The claude CLI holds your login and does its own authenticating. The plugin never reads, stores or replays a token of its own: there is nothing in it to lift.',
        bar: true,
        stream: true,
      },
    ],
  },
  {
    id: 'btw',
    label: '/btw aside',
    title: 'A side question while the turn keeps running (opencode 1.x, CLI 2.1.258+)',
    lines: [
      { lane: 'opencode', tag: 'you', text: 'tighten the deadline guard in the broker and run the suite', wait: 900 },
      {
        lane: 'claude',
        text: '{"type":"assistant", … {"type":"tool_use","name":"mcp__opencode_proxy__edit","input":{"filePath":"src/proxy-broker.ts", …}}}',
        wait: 420,
      },
      {
        lane: 'plugin',
        tag: 'tool-call',
        text: 'edit → opencode. Runs here, under your permission rules; the request is held open while it does.',
        bar: true,
        wait: 800,
      },
      {
        lane: 'opencode',
        tag: 'you',
        text: '/btw why a guard instead of a longer deadline?',
        note: 'typed while the turn is still running',
        wait: 900,
      },
      {
        lane: 'plugin',
        tag: 'side_question',
        text: "{\"type\":\"control_request\",\"request\":{\"subtype\":\"side_question\", …}} → the same live process, same model and account, concurrent with the turn. The aside never enters Claude's transcript.",
        bar: true,
        wait: 800,
      },
      {
        lane: 'opencode',
        tag: 'receipt',
        text: '▌ btw: why a guard instead of a longer deadline?  ▌ sent to Claude on the side',
        bar: true,
        wait: 800,
      },
      {
        lane: 'claude',
        text: '{"type":"control_response","response":{"response":{"response":"A fixed deadline would count the operator\'s time on a permission prompt …"}}}',
        wait: 500,
      },
      {
        lane: 'opencode',
        tag: 'reply',
        text: '▌ btw: a deadline would count your time on a permission prompt. The guard keeps the call while opencode still reports it busy, re-checking on an interval, and lets the deadline end it only once it does not.',
        note: 'written into the reply you are watching; the turn goes on below it',
        bar: true,
        stream: true,
      },
    ],
  },
];
---

<figure
  class="occ-replay not-content"
  data-mode="css"
  data-playback="playing"
  aria-label="Three turns, replayed: what opencode, the plugin and claude --print each do"
>
  <figcaption class="occ-replay__cap">
    <span class="occ-replay__flow" aria-hidden="true">
      <span class="occ-lane--opencode">Opencode</span>
      <svg class="occ-flow__mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="8" height="26" rx="2" fill="var(--occ-bar)"></rect><path d="M16 8 L25 16 L16 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span class="occ-lane--plugin">Plugin</span>
      <svg class="occ-flow__mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="8" height="26" rx="2" fill="var(--occ-bar)"></rect><path d="M16 8 L25 16 L16 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span class="occ-lane--claude">Claude</span>
    </span>
    <span class="occ-replay__controls">
      <button type="button" class="occ-replay__btn occ-replay__pause" aria-pressed="false" hidden>pause</button>
      <button type="button" class="occ-replay__btn occ-replay__restart" hidden>replay</button>
    </span>
  </figcaption>

  <div class="occ-replay__tabs" role="tablist" aria-label="Which turn to replay">
    {
      turns.map((turn, index) => (
        <button
          type="button"
          role="tab"
          id={`occ-tab-${turn.id}`}
          class="occ-replay__tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`occ-turn-${turn.id}`}
          tabindex={index === 0 ? 0 : -1}
          title={turn.title}
          disabled
        >
          <span class="occ-replay__tab-n" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="occ-replay__tab-label">{turn.label}</span>
          <span class="occ-replay__tab-bar" aria-hidden="true" />
        </button>
      ))
    }
  </div>

  <div class="occ-replay__stage">
    {
      turns.map((turn, index) => (
        <div
          id={`occ-turn-${turn.id}`}
          role="tabpanel"
          aria-labelledby={`occ-tab-${turn.id}`}
          class:list={['occ-replay__panel', { 'is-active': index === 0 }]}
        >
          <ol class="occ-replay__lines" role="list">
            {turn.lines.map((line, lineIndex) => (
              <li
                class:list={[
                  'occ-line',
                  `occ-line--${line.lane}`,
                  {
                    'occ-line--bar': line.bar,
                    'occ-line--reply': line.tag === 'reply',
                    'occ-line--stream': line.stream,
                    'occ-line--type': line.tag === 'you',
                  },
                ]}
                style={`--i:${lineIndex}`}
                data-wait={line.wait}
              >
                <span class="occ-line__lane">{line.lane}</span>
                <span class="occ-line__bar" aria-hidden="true" />
                <span class="occ-line__body">
                  {line.tag && <span class="occ-line__tag">{line.tag}</span>}<span class="occ-line__text">{line.tag === 'you' ? Array.from(line.text).map((char) => <span class="occ-char">{char}</span>) : line.stream ? words(line.text).map((word) => <span class="occ-word">{word}</span>) : tokenize(line.text).map((token) => (token.cls ? <span class={`occ-tok--${token.cls}`}>{token.text}</span> : token.text))}</span>
                  {line.note && <span class="occ-line__note"> · {line.note}</span>}
                </span>
              </li>
            ))}
            <li class="occ-line occ-line--cursor" aria-hidden="true" style={`--i:${turn.lines.length}`}>
              <span class="occ-line__lane" />
              <span class="occ-line__bar" />
              <span class="occ-cursor" />
            </li>
          </ol>
        </div>
      ))
    }
  </div>
</figure>

<script>
  // One clock. Each tick reveals the next line of the current turn, or the next word
  // of its final answer, waits that line's own pacing, holds at the end of the turn,
  // then moves to the next turn. Every pause and resume goes through the same clock,
  // so nothing can run on while the panel says it is paused.
  const root = document.querySelector<HTMLElement>('.occ-replay');

  if (root) {
    root.dataset.mode = 'js';
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.occ-replay__panel'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.occ-replay__tab'));
    const stage = root.querySelector<HTMLElement>('.occ-replay__stage');
    const pauseButton = root.querySelector<HTMLButtonElement>('.occ-replay__pause');
    const restartButton = root.querySelector<HTMLButtonElement>('.occ-replay__restart');

    const FIRST_MS = 400;
    const LINE_MS = 520;
    const WORD_MS = 46;
    const HOLD_MS = 6000;
    const SPEAKER_MS = 240;
    const CHAR_MS = 34;

    interface Step {
      line: HTMLElement;
      /** First who: the speaker step shows the lane; the body steps then show what was said. */
      speaker?: boolean;
      /** One typed character of what the user wrote, or one streamed word of a reply. */
      part?: HTMLElement;
      /** The step that completes its line: a whole body, or its last character or word. */
      ends: boolean;
      wait: number;
    }
    const scripts: Step[][] = panels.map((panel) => {
      const steps: Step[] = [];
      panel.querySelectorAll<HTMLElement>('.occ-line:not(.occ-line--cursor)').forEach((line) => {
        const wait = Number(line.dataset.wait) || LINE_MS;
        steps.push({ line, speaker: true, ends: false, wait: SPEAKER_MS });
        const parts = Array.from(line.querySelectorAll<HTMLElement>('.occ-char, .occ-word'));
        if (parts.length === 0) {
          steps.push({ line, ends: true, wait });
          return;
        }
        const typed = line.classList.contains('occ-line--type');
        parts.forEach((part, index) => {
          const ends = index === parts.length - 1;
          steps.push({ line, part, ends, wait: ends ? wait : typed ? CHAR_MS : WORD_MS });
        });
      });
      return steps;
    });
    const totals = scripts.map((steps) => steps.reduce((sum, step) => sum + step.wait, 0));

    let current = 0;
    let done = 0; // steps of the current turn already on screen
    let elapsed = 0; // their pacing, summed, for the progress bar
    let manual = false; // a turn picked by hand plays and then stays
    let paused = false;
    let hovering = false;
    let focused = false;
    let visible = true;
    let timer = 0;
    let deadline = 0;
    let remaining = FIRST_MS;
    let cursor: HTMLElement | null = null;

    const atEnd = () => done >= scripts[current].length;

    const stopClock = () => {
      if (!timer) return;
      remaining = Math.max(0, deadline - performance.now());
      window.clearTimeout(timer);
      timer = 0;
    };

    const setCursor = (element: HTMLElement | null) => {
      cursor?.classList.remove('is-cursor');
      cursor = element;
      cursor?.classList.add('is-cursor');
    };

    const paint = () => {
      tabs.forEach((tab, index) => {
        const selected = index === current;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const progress = Math.min(1, elapsed / totals[index]);
        tab.style.setProperty('--p', selected ? String(progress) : '0');
      });
      panels.forEach((panel, index) => panel.classList.toggle('is-active', index === current));
      const blocked = paused || !visible || document.hidden;
      root.dataset.playback = blocked ? 'paused' : atEnd() ? 'holding' : 'playing';
    };

    const clear = (index: number) => {
      scripts[index].forEach((step) => {
        step.line.classList.remove('is-shown', 'is-done', 'is-body');
        step.part?.classList.remove('is-shown');
      });
    };

    const syncClock = () => {
      stopClock();
      paint();
      if (paused || !visible || document.hidden) return;
      if (atEnd() && (manual || hovering || focused)) return;
      deadline = performance.now() + remaining;
      timer = window.setTimeout(tick, remaining);
    };

    const tick = () => {
      timer = 0;
      if (atEnd()) {
        select((current + 1) % panels.length, false);
        return;
      }
      const step = scripts[current][done];
      done += 1;
      elapsed += step.wait;
      step.line.classList.add('is-shown');
      if (!step.speaker) step.line.classList.add('is-body');
      step.part?.classList.add('is-shown');
      if (step.ends) step.line.classList.add('is-done');
      setCursor(
        step.speaker
          ? step.line.querySelector<HTMLElement>('.occ-line__lane')
          : (step.part ?? step.line.querySelector<HTMLElement>('.occ-line__text')),
      );
      remaining = atEnd() ? HOLD_MS : step.wait;
      syncClock();
    };

    const select = (index: number, byHand: boolean) => {
      stopClock();
      clear(current);
      setCursor(null);
      current = index;
      done = 0;
      elapsed = 0;
      remaining = FIRST_MS;
      if (byHand) manual = true;
      syncClock();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      if (pauseButton) {
        pauseButton.textContent = paused ? 'play' : 'pause';
        pauseButton.setAttribute('aria-pressed', String(paused));
      }
      syncClock();
    };

    tabs.forEach((tab, index) => {
      tab.disabled = false;
      tab.addEventListener('click', () => select(index, true));
      tab.addEventListener('keydown', (event) => {
        const targets: Record<string, number> = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: tabs.length - 1 };
        const target = targets[event.key];
        if (target === undefined) return;
        event.preventDefault();
        const next = (target + tabs.length) % tabs.length;
        tabs[next].focus();
        select(next, true);
      });
    });
    pauseButton?.addEventListener('click', () => setPaused(!paused));
    restartButton?.addEventListener('click', () => {
      paused = false;
      if (pauseButton) {
        pauseButton.textContent = 'pause';
        pauseButton.setAttribute('aria-pressed', 'false');
      }
      select(current, false);
    });
    // A click on the transcript itself pauses or resumes it, unless the click was a
    // text selection. Selecting a line to copy it must never restart the clock.
    stage?.addEventListener('click', () => {
      if (window.getSelection()?.toString()) return;
      setPaused(!paused);
    });
    root.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      hovering = true;
      syncClock();
    });
    root.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      hovering = false;
      syncClock();
    });
    root.addEventListener('focusin', () => {
      focused = true;
      syncClock();
    });
    root.addEventListener('focusout', (event) => {
      if (root.contains(event.relatedTarget as Node | null)) return;
      focused = false;
      syncClock();
    });
    document.addEventListener('visibilitychange', syncClock);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          syncClock();
        },
        { threshold: 0.2 },
      ).observe(root);
    }

    // Hidden in the markup, because without scripting there is no clock to pause.
    if (pauseButton) pauseButton.hidden = false;
    if (restartButton) restartButton.hidden = false;
    select(0, false);
  }
</script>

<style>
  .occ-replay {
    margin: 0;
    border: 1px solid var(--occ-line);
    border-radius: var(--occ-radius);
    background: var(--occ-panel);
    box-shadow:
      inset 0 1px 0 var(--occ-highlight),
      var(--sl-shadow-md);
    overflow: hidden;
    min-width: 0;
    font-family: var(--__sl-font-mono);
    font-variant-ligatures: none;
  }
  .occ-replay__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--occ-space-4);
    padding: 0 var(--occ-space-2) 0 var(--occ-space-4);
    min-block-size: 2.75rem;
    border-bottom: 1px solid var(--occ-line);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--occ-ink-3);
  }
  /* The caption is the pipeline itself: Opencode, the mark, Plugin, the mark, Claude,
     in the three voices' colours, so it is the legend too. */
  .occ-replay__flow {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .occ-flow__mark {
    flex: none;
    inline-size: 1.25em;
    block-size: 1.25em;
    color: var(--occ-ink-2);
  }
